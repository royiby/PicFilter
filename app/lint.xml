<?xml version="1.0" encoding="utf-8"?>
<!--
  Lint had never been run on this project; the first run reported 108 findings.
  This file records the ones that are deliberate, with the reason, so the
  report stays worth reading. Anything not listed here is a real finding.
-->
<lint>

    <!--
      DevOps.kt is the adb-driven developer surface: ops that write their
      results to a debug TextView and to logcat. Those strings are field names
      and measurements, read by whoever is holding the cable, and translating
      them would make them stop matching the log lines they are compared
      against. The user-facing screens are fully localised.
    -->
    <issue id="SetTextI18n">
        <ignore path="src/main/java/com/picfilter/spike/DevOps.kt" />
    </issue>

    <!--
      The remaining candidates are diagnostic lines ("faces=3  matched=1") and
      screen-reader strings that read a position aloud. A plural form of
      "faces=%d" would be a translation of a column name.
    -->
    <issue id="PluralsCandidate" severity="informational" />

    <!--
      The wordmark is an 8,677-character path. Lint is right that long vector
      paths cost time to parse, and it is the logo: one instance, drawn once
      when a screen is built, never animated. Simplifying it is a design
      change to the brand mark, not a performance fix, so it is a decision
      rather than a finding.
    -->
    <issue id="VectorPath">
        <ignore path="src/main/res/drawable/ic_logo_wordmark.xml" />
        <ignore path="src/main/res/drawable-night/ic_logo_wordmark.xml" />
    </issue>

    <!--
      Kept deliberately, not forgotten. The brand colours are the record of
      what the mark IS -- the logo drawables carry their own literals so it
      renders the same whatever the theme does -- and pk_success completes the
      status set beside pk_warning and pk_error. The tagline and the scan's
      first phase label are copy the screens may want back.
    -->
    <issue id="UnusedResources">
        <ignore regexp="R.color.brand_" />
        <ignore regexp="R.color.pk_success" />
        <ignore regexp="R.string.tagline" />
        <ignore regexp="R.string.onboard_starting" />
    </issue>

</lint>
