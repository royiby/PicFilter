<?xml version="1.0" encoding="utf-8"?>
<!--
  PixKin color roles — light.

  "Gallery": paper-white surfaces, ink text, one deep accent used sparingly.

  Three things changed from the first palette, all of them reasons it read as
  confectionery rather than as something expensive:

  1. The surfaces were within six points of each other (#FFFAF6 / #FFFFFF /
     #FFF1E6), so a card floated on nothing. They are separated now.
  2. The accent was full-saturation cherry at #D7263D and it was doing routine
     work — the loudest colour in the palette sat on a toggle. The claret below
     is the same hue family, darker and calmer, so it still belongs to the
     cherry logo while costing less attention.
  3. Text was #1D1B19 on warm cream. Ink on paper-white carries more contrast
     and lets the photographs be the colourful thing on screen, which on a
     photo app is the whole point.

  The brand_* values are the logo's own and are deliberately untouched.
-->
<resources>
    <!--
      Brand. Lint reports these as unused and they are: the logo drawables
      carry their own literals so the mark renders identically whatever the
      theme does. They stay as the record of what the brand colours ARE, for
      the next illustration or a store listing, and are marked so the report
      does not keep asking.
    -->
    <color name="brand_cherry">#FFD7263D</color>
    <color name="brand_stem">#FF2E8B57</color>
    <color name="brand_leaf">#FF3FA66B</color>
    <color name="brand_cream">#FFFFF1E6</color>

    <!-- Theme roles -->
    <color name="pk_primary">#FF8C1C2B</color>
    <color name="pk_on_primary">#FFFFFFFF</color>
    <color name="pk_primary_container">#FFF6E7E7</color>
    <color name="pk_on_primary_container">#FF3A0A11</color>
    <color name="pk_secondary">#FF2F5D45</color>
    <color name="pk_on_secondary">#FFFFFFFF</color>
    <color name="pk_secondary_container">#FFDDE8E0</color>
    <color name="pk_on_secondary_container">#FF102A1E</color>
    <color name="pk_background">#FFFAF9F7</color>
    <color name="pk_on_background">#FF16140F</color>
    <color name="pk_surface">#FFFFFFFF</color>
    <color name="pk_on_surface">#FF16140F</color>
    <color name="pk_surface_variant">#FFF1EFEB</color>
    <color name="pk_on_surface_variant">#FF5C564E</color>
    <color name="pk_outline">#FF8A837A</color>
    <color name="pk_outline_variant">#FFE3DFD8</color>
    <color name="pk_error">#FF8A2B10</color>
    <color name="pk_on_error">#FFFFFFFF</color>
    <!-- Paired with pk_warning and pk_error; kept so the status set is whole. -->
    <color name="pk_success">#FF2F5D45</color>
    <color name="pk_warning">#FF8A5A12</color>
</resources>
