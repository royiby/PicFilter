<?xml version="1.0" encoding="utf-8"?>
<!--
  Hebrew. The locale this app was actually built for: the people it recognises
  are named גבע, דני, אבי, אמא and מישי.

  Hebrew reads right to left, so the layout mirrors; see supportsRtl in the
  manifest and setMarginsRelative in Ui.kt. It also has a dual, which is why
  several plurals here carry a "two" that English does not have.
-->
